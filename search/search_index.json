{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Welcome to MkDocs","text":"<p>For full documentation visit mkdocs.org.</p>"},{"location":"#commands","title":"Commands","text":"<ul> <li><code>mkdocs new [dir-name]</code> - Create a new project.</li> <li><code>mkdocs serve</code> - Start the live-reloading docs server.</li> <li><code>mkdocs build</code> - Build the documentation site.</li> <li><code>mkdocs -h</code> - Print help message and exit.</li> </ul>"},{"location":"#project-layout","title":"Project layout","text":"<pre><code>mkdocs.yml    # The configuration file.\ndocs/\n    index.md  # The documentation homepage.\n    ...       # Other markdown pages, images and other files.\n</code></pre>"},{"location":"ai_pm/%E6%A8%A1%E5%9E%8B%E9%80%89%E5%9E%8B/","title":"\u6a21\u578b\u9009\u578b","text":""},{"location":"ai_pm/%E6%A8%A1%E5%9E%8B%E9%80%89%E5%9E%8B/#_1","title":"\u4e00\u3001\u6a21\u578b\u9009\u578b\u8bc4\u4f30\u7ef4\u5ea6","text":""},{"location":"ai_pm/%E6%A8%A1%E5%9E%8B%E9%80%89%E5%9E%8B/#1","title":"1\u3001\u4e1a\u52a1\u7ef4\u5ea6","text":"<ul> <li>\u4efb\u52a1\u5339\u914d\u5ea6</li> </ul> <p>\u200b   \u5224\u522b\u5f0f VS \u751f\u6210\u5f0f \uff1a \u6253\u6807\u7b7e\u8fd8\u662f\u5199\u6587\u672c\uff1f</p> <p>\u200b   \u7279\u5b9a\u9886\u57df VS \u901a\u7528 \uff1a \u662f\u5426\u9700\u8981\u4e13\u4e1a\u77e5\u8bc6\uff1f</p> <ul> <li>\u4ea7\u54c1\u76ee\u6807\u5bf9\u9f50</li> </ul> <p>\u8ffd\u6c42\u6548\u679c\u8d28\u91cf \u2014\u2014&gt; \u613f\u610f\u4ed8\u66f4\u9ad8\u6210\u672c</p> <p>\u8ffd\u6c42\u6279\u91cf\u6548\u7387 \u2014\u2014&gt; \u503e\u5411\u8f7b\u91cf\u3001\u5feb\u901f\u3001\u4fbf\u5b9c</p> <ul> <li>\u573a\u666f\u7ea6\u675f</li> </ul> <p>\u5b9e\u65f6\u6027\uff1a\u6beb\u79d2\u7ea7 \uff1f \u79d2\u7ea7</p> <p>\u90e8\u7f72\u73af\u5883 \uff1a \u4e91\u7aefAPI or \u5ba2\u6237\u5185\u7f51\u79c1\u6709\u5316\uff1f</p>"},{"location":"ai_pm/%E6%A8%A1%E5%9E%8B%E9%80%89%E5%9E%8B/#2","title":"2\u3001\u6548\u679c\u7ef4\u5ea6","text":"<ul> <li>\u51c6\u786e\u7387/\u7cbe\u786e\u7387  \uff1a\u201c\u7b54\u5f97\u5bf9\u4e0d\u5bf9\u201d\uff0c\u5b81\u613f\u4e0d\u7b54\uff0c\u4e0d\u80fd\u9519\u7b54\uff1b</li> <li>\u53ec\u56de\u7387 \uff1a\u201c\u627e\u7684\u5168\u4e0d\u5168\u201d\uff0c\u5185\u5bb9\u98ce\u63a7\uff0c\u5fc5\u987b\u5c3d\u91cf\u627e\u5168\uff1b</li> <li>\u9c81\u68d2\u6027 \uff1a \u201c\u9047\u5230\u810f\u6570\u636e\u5d29\u4e0d\u5d29\u201d\uff0c\u4e0d\u80fd\u53ea\u770b\u5185\u90e8\u6d4b\u8bd5\u7ed3\u679c\uff0c\u5ba2\u6237\u95ee\u989880%\u4e0e\u6d4b\u8bd5\u96c6\u4e0d\u540c\uff0c\u9047\u5230\u810f\u6570\u636e\u8981\u80fd\u591f\u4f18\u96c5\u964d\u7ea7\u5904\u7406\uff1b</li> <li>\u4e00\u81f4\u6027 \uff1a \u201c\u56de\u7b54\u7a33\u4e0d\u7a33\u201d\uff0c\u5e76\u4e0d\u662f\u8bf4\u6bcf\u6b21\u56de\u7b54\u8981\u5b8c\u5168\u4e00\u6837\uff0c\u800c\u662f\u8981\u56de\u7b54\u6b63\u786e\uff0c\u4e0d\u80fd\u778e\u8bf4\u3002</li> </ul>"},{"location":"ai_pm/%E6%A8%A1%E5%9E%8B%E9%80%89%E5%9E%8B/#3","title":"3\u3001\u6210\u672c\u7ef4\u5ea6","text":"<ul> <li>\u7b97\u529b/\u8c03\u7528\u6210\u672c \uff1a API\u6309token\u79ef\u5206 or \u81ea\u90e8\u7f72GPU\u6210\u672c\uff1b</li> <li>\u6570\u636e\u6210\u672c \uff1a \u9ad8\u8d28\u91cf\u5fae\u8c03\u6570\u636e\u7684\u83b7\u53d6\u548c\u6807\u6ce8\u6210\u672c\uff1b</li> <li>\u4eba\u529b\u548c\u65f6\u95f4\u6210\u672c \uff1a \u56e2\u961f\u6709\u6ca1\u6709\u81ea\u7814\u80fd\u529b\uff1f</li> </ul>"},{"location":"ai_pm/%E6%A8%A1%E5%9E%8B%E9%80%89%E5%9E%8B/#4","title":"4\u3001\u5de5\u7a0b\u7ef4\u5ea6","text":"<ul> <li>\u63a8\u7406\u901f\u5ea6 \uff1a \u5355\u8bcd\u8c03\u7528\u8017\u65f6\uff0c\u80fd\u5426\u625b\u4f4f\u9ad8\u5cf0\u671fOPS\uff1b</li> <li>\u7a33\u5b9a\u6027\u4e0eSLA \uff1a \u53ef\u7528\u6027\u627f\u8bfa\uff0c\u6709\u6ca1\u6709\u964d\u7ea7\u9884\u6848\uff1b</li> <li>\u53ef\u7ef4\u62a4\u6027 \uff1a \u90e8\u7f72\u3001\u76d1\u63a7\u3001\u66f4\u65b0\u3001\u56de\u6eda\u7684\u80fd\u529b\uff1b</li> <li>\u96c6\u6210\u6210\u672c\uff1a\u662f\u5426\u9700\u8981\u989d\u5916\u7ec4\u4ef6\uff0c\u5982\u5411\u91cf\u6570\u636e\u5e93</li> </ul>"},{"location":"ai_pm/%E6%A8%A1%E5%9E%8B%E9%80%89%E5%9E%8B/#5","title":"5\u3001\u751f\u6001\u4e0e\u5b89\u5168\u7ef4\u5ea6","text":"<ul> <li>\u751f\u6001\u4e0e\u793e\u533a \uff1a \u5f00\u6e90\u793e\u533a\u7684\u6d3b\u8dc3\u5ea6\uff0c\u9047\u5230\u95ee\u9898\u6709\u6ca1\u6709\u529e\u6cd5\u89e3\u51b3\uff1b</li> <li>\u6570\u636e\u5b89\u5168\u548c\u9690\u79c1 \uff1a \u6570\u636e\u80fd\u4e0d\u80fd\u51fa\u516c\u7f51\uff1f\u9700\u4e0d\u9700\u8981\u5185\u7f51\u90e8\u7f72\uff1f</li> <li>\u5408\u89c4\u98ce\u9669 \uff1a \u53ef\u89e3\u91ca\u6027\u3001\u5185\u5bb9\u7248\u6743\u662f\u5426\u7b26\u5408\u76d1\u7ba1\uff1b</li> <li>\u4f9b\u5e94\u5546\u9501\u5b9a \uff1a\u662f\u5426\u4f1a\u88ab\u4e00\u5bb6\u4e91\u5382\u5546\u6df1\u5ea6\u7ed1\u5b9a\uff0c\u5931\u53bb\u8bae\u4ef7\u6743\u3002</li> </ul>"}]}